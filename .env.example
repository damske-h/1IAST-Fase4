# Copie para .env (que está no .gitignore) e preencha. Nunca faça commit do .env.
# Chave do Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=models/gemini-3.8-flash

# Opcional: fallback para OpenAI, usado se o Gemini não responder
OPENAI_API_KEY=
LLM_PROVIDER=auto

# Opcional: chamadas por minuto ao LLM (o plano gratuito do Gemini aceita ~10)
LLM_RPM=8
